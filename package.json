{
	"name": "ddlazy-ui-plus",
	"version": "0.0.2",
	"type": "module",
	"description": "A Component Library for Vue3.",
	"main": "lib/ddlazy-ui-plus.es",
	"engines": {
		"node": "^22.0.0 || >=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Lazydd/ddlazy-ui-plus.git"
	},
	"files": [
		"lib"
	],
	"scripts": {
		"dev": "pnpm build:ui && vitepress dev docs",
		"dev:ui": "vite",
		"build:ui": "vite build && pnpm build:dts",
		"build:doc": "pnpm build:ui && vitepress build docs",
		"build:dts": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.packages.json",
		"fmt": "oxfmt packages/**/*",
		"fmt:check": "oxfmt --check packages/**/*",
		"serve": "vitepress serve docs",
		"preview": "vitepress preview docs"
	},
	"author": "ddlazy",
	"license": "MIT",
	"private": true,
	"keywords": [
		"vue3",
		"组件库"
	],
	"devDependencies": {
		"@ddlazy/utils": "^0.0.7",
		"@iconify/json": "^2.2.471",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vitejs/plugin-vue-jsx": "^5.1.6",
		"@vueuse/components": "^15.0.0",
		"@vueuse/core": "^15.0.0",
		"feed": "^6.0.0",
		"markdown-it": "^15.0.3",
		"md5": "^2.3.0",
		"oxfmt": "^0.70.0",
		"sass": "^1.100.0",
		"simple-git": "^4.0.2",
		"unocss": "^66.6.7",
		"vite": "^8.3.8",
		"vitepress": "^1.6.4",
		"vitepress-theme-demoblock-fork": "^3.1.3",
		"vue-tsc": "^3.3.14"
	},
	"dependencies": {
		"dayjs": "^1.11.23",
		"vue": "^3.5.45",
		"vxe-pc-ui": "^4.20.42",
		"vxe-table": "^4.23.19"
	},
	"browserslist": [
		"> 1%",
		"last 2 versions",
		"not dead"
	]
}
